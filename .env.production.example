# Copy to .env.production. Keep it off shared drives and out of git.

# 32 random bytes each: openssl rand -base64 32
RKL_FIELD_KEY=
RKL_STORAGE_KEY=

RKL_APP_DB_PASSWORD=
RKL_REDIS_PASSWORD=
RKL_DB_PASSWORD=

RKL_DATABASE_URL=postgresql+psycopg://rkl_app:PASSWORD@db:5432/rkl?sslmode=verify-full&sslrootcert=/certs/ca.crt
RKL_MIGRATE_DATABASE_URL=postgresql+psycopg://rkl:PASSWORD@db:5432/rkl?sslmode=verify-full&sslrootcert=/certs/ca.crt
RKL_REDIS_URL=rediss://:PASSWORD@redis:6379/0?ssl_ca_certs=/certs/ca.crt

RKL_PROBE_RETENTION_DAYS=90

# Leave false until the model licence is confirmed in writing. The API won't start without it.
# See CLAUDE.md, Licensing.
RKL_MODEL_LICENCE_CONFIRMED=false
